# Resend API key (server-only). Get one at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact form messages.
# With the default sender, Resend only delivers to your Resend account email.
CONTACT_TO_EMAIL=

# Optional. Defaults to "Arcade Vault <onboarding@resend.dev>".
# Use an address on a verified domain to send to other recipients.
# CONTACT_FROM_EMAIL=Arcade Vault <contact@yourdomain.com>

# Supabase. Find both in the Supabase dashboard: Project Settings -> API Keys.
# URL looks like https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Use the PUBLISHABLE key (sb_publishable_...). Never put the secret / service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
